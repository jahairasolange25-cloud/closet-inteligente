# ============================================================
# CLOSET INTELIGENTE — STAGING ENVIRONMENT
# ============================================================
# Copy to .env.staging for local staging deployment.
# Staging mimics production settings with safe defaults.
# ============================================================

NODE_ENV=production
PORT=4000

# ──────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=closet_staging
DB_USER=closet
DB_PASSWORD=closet_staging_secret
DATABASE_URL=postgresql://closet:closet_staging_secret@postgres:5432/closet_staging

POSTGRES_DB=closet_staging
POSTGRES_USER=closet
POSTGRES_PASSWORD=closet_staging_secret

# ──────────────────────────────────────────────────────────
# JWT  — use separate secrets from dev
# ──────────────────────────────────────────────────────────
JWT_SECRET=staging-jwt-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=staging-refresh-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=closet:

# ──────────────────────────────────────────────────────────
# CLOUDINARY  (required for upload endpoints)
# ──────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-staging-cloud
CLOUDINARY_API_KEY=your-staging-api-key
CLOUDINARY_API_SECRET=your-staging-api-secret

# ──────────────────────────────────────────────────────────
# AI SERVICE
# ──────────────────────────────────────────────────────────
AI_SERVICE_URL=http://closet-ai:5100
AI_STEP_TIMEOUT_MS=30000
AI_GLOBAL_TIMEOUT_MS=120000
AI_MAX_RETRIES=2

# ──────────────────────────────────────────────────────────
# CORS  — staging domain(s)
# ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000,http://localhost

# ──────────────────────────────────────────────────────────
# RATE LIMITING  — relaxed for staging
# ──────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_LIMIT=120
RATE_LIMIT_DEFAULT_TTL=60000

# ──────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=json

# ──────────────────────────────────────────────────────────
# METRICS & OBSERVABILITY
# ──────────────────────────────────────────────────────────
METRICS_ENABLED=true
OTEL_SERVICE_NAME=closet-staging-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ──────────────────────────────────────────────────────────
# REQUEST TIMEOUT
# ──────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000

# ──────────────────────────────────────────────────────────
# QUEUE
# ──────────────────────────────────────────────────────────
QUEUE_JOB_TIMEOUT_MS=300000

# ──────────────────────────────────────────────────────────
# FRONTEND
# ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_WS_URL=http://localhost
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_APP_NAME="Closet Inteligente (Staging)"
NEXT_PUBLIC_ENABLE_3D=false
NEXT_PUBLIC_ENABLE_AI_RECOMMENDATIONS=true
