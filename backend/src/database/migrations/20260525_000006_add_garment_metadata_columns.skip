-- Migration: 20260525_000006
-- Adds metadata columns to garments that are part of the API contract
-- but were absent from the initial schema (000009).
-- These columns are used by CreateGarmentDto / UpdateGarmentDto.

BEGIN;

ALTER TABLE garments
  ADD COLUMN IF NOT EXISTS subcategory VARCHAR(100),
  ADD COLUMN IF NOT EXISTS notes TEXT,
  ADD COLUMN IF NOT EXISTS materials TEXT[],
  ADD COLUMN IF NOT EXISTS tags TEXT[],
  ADD COLUMN IF NOT EXISTS is_favorite BOOLEAN NOT NULL DEFAULT false,
  ADD COLUMN IF NOT EXISTS processing_status VARCHAR(20) NOT NULL DEFAULT 'pending',
  ADD COLUMN IF NOT EXISTS detected_attributes JSONB;

CREATE INDEX IF NOT EXISTS idx_garments_is_favorite ON garments(user_id, is_favorite) WHERE deleted_at IS NULL;
CREATE INDEX IF NOT EXISTS idx_garments_processing_status ON garments(processing_status);
CREATE INDEX IF NOT EXISTS idx_garments_tags ON garments USING GIN(tags);

COMMIT;
