# ============================================================
# CLOSET INTELIGENTE — ENVIRONMENT VARIABLES REFERENCE
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is in .gitignore.
#
# Generate strong JWT secrets with:
#   openssl rand -base64 64
# ============================================================

NODE_ENV=development
PORT=4000

# ──────────────────────────────────────────────────────────
# DATABASE  (matches docker-compose.yml defaults)
# ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=closet
DB_USER=closet
DB_PASSWORD=closet_secret

POSTGRES_DB=closet
POSTGRES_USER=closet
POSTGRES_PASSWORD=closet_secret
DATABASE_URL=postgresql://closet:closet_secret@localhost:5432/closet

# ──────────────────────────────────────────────────────────
# JWT  — generate both secrets with: openssl rand -base64 64
# ──────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────────────────
# REDIS  (matches docker-compose.yml defaults)
# ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=closet:

# ──────────────────────────────────────────────────────────
# SUPABASE  (optional — auth falls back to local JWT if unset)
# ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────────────────────
# CLOUDINARY  (required for file upload endpoints)
# ──────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ──────────────────────────────────────────────────────────
# AI SERVICE  (Python CV service connection)
# ──────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:5100
AI_STEP_TIMEOUT_MS=30000
AI_GLOBAL_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
# Set AI_ADAPTER=simulated to use in-memory stub instead of real HTTP call
# AI_ADAPTER=simulated

# ──────────────────────────────────────────────────────────
# CORS
# Comma-separated list of allowed origins (no trailing slashes).
# Production example: https://app.closet.com,https://www.closet.com
# ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────
# RATE LIMITING  (requests per TTL window, TTL in milliseconds)
# ──────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_TTL=60000

# ──────────────────────────────────────────────────────────
# METRICS & OBSERVABILITY
# ──────────────────────────────────────────────────────────
METRICS_ENABLED=true
OTEL_SERVICE_NAME=closet-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ──────────────────────────────────────────────────────────
# REQUEST TIMEOUT  (milliseconds before returning 408)
# ──────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000

# ──────────────────────────────────────────────────────────
# QUEUE  (BullMQ job timeout in milliseconds)
# ──────────────────────────────────────────────────────────
QUEUE_JOB_TIMEOUT_MS=300000
