# E2E Environment — loaded by global-setup.ts
E2E_BASE_URL=http://localhost:3000
E2E_API_URL=http://localhost:4000
E2E_WS_URL=http://localhost:4000

# Test user credentials — created by seed
E2E_TEST_EMAIL=e2e@test.com
E2E_TEST_PASSWORD=Test1234!
E2E_TEST_NAME=E2E Tester

# Docker
E2E_DOCKER_COMPOSE_FILE=../docker-compose.yml
E2E_DOCKER_PROJECT=closet-inteligente

# Database (direct connection for seed/clean)
E2E_DB_HOST=localhost
E2E_DB_PORT=5432
E2E_DB_NAME=closet
E2E_DB_USER=closet
E2E_DB_PASSWORD=closet_secret

# CI mode — when set, skips docker compose start
CI=false
