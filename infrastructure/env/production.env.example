# ============================================================
# CLOSET INTELIGENTE — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================
# Copy to your secrets manager and fill in real values.
# NEVER commit secrets to git.
# ============================================================

NODE_ENV=production
PORT=4000

# ──────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────
DB_HOST=postgres.cluster.internal
DB_PORT=5432
DB_NAME=closet_prod
DB_USER=closet_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_64_CHARS
DATABASE_URL=postgresql://closet_app:CHANGE_ME@postgres.cluster.internal:5432/closet_prod?ssl=true

POSTGRES_DB=closet_prod
POSTGRES_USER=closet_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_64_CHARS

# Connection pool
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# ──────────────────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_64
JWT_REFRESH_SECRET=CHANGE_ME_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────────────────
# REDIS
# ──────────────────────────────────────────────────────────
REDIS_HOST=redis.cluster.internal
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_KEY_PREFIX=closet:
REDIS_TLS_ENABLED=true

# ──────────────────────────────────────────────────────────
# SUPABASE (optional — omit if using local JWT only)
# ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────────────────────
# CLOUDINARY (required for file upload)
# ──────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ──────────────────────────────────────────────────────────
# AI SERVICE (Python CV service)
# ──────────────────────────────────────────────────────────
AI_SERVICE_URL=http://closet-ai:5100
AI_STEP_TIMEOUT_MS=30000
AI_GLOBAL_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
# AI_ADAPTER=simulated

# ──────────────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────────────
CORS_ORIGIN=https://app.closet.com,https://admin.closet.com

# ──────────────────────────────────────────────────────────
# RATE LIMITING
# ──────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT_LIMIT=60
RATE_LIMIT_DEFAULT_TTL=60000

# ──────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=/var/log/closet

# ──────────────────────────────────────────────────────────
# METRICS & OBSERVABILITY
# ──────────────────────────────────────────────────────────
METRICS_ENABLED=true
OTEL_SERVICE_NAME=closet-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ──────────────────────────────────────────────────────────
# SSL / TLS
# ──────────────────────────────────────────────────────────
SSL_CERT_PATH=/etc/ssl/certs/closet.crt
SSL_KEY_PATH=/etc/ssl/private/closet.key

# ──────────────────────────────────────────────────────────
# BACKUP
# ──────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/closet
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=s3://closet-backups
BACKUP_S3_REGION=us-east-1

# ──────────────────────────────────────────────────────────
# HEALTH CHECKS
# ──────────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=60s
