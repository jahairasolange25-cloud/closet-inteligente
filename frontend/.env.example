# Backend API
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Auth
NEXT_PUBLIC_JWT_STORAGE_KEY=closet_access_token
NEXT_PUBLIC_REFRESH_TOKEN_KEY=closet_refresh_token

# Cloudinary (read-only — upload handled backend-side)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Closet Inteligente

# Feature flags
NEXT_PUBLIC_ENABLE_3D=false
NEXT_PUBLIC_ENABLE_AI_RECOMMENDATIONS=true
